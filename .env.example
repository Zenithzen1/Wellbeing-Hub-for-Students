# Copy to .env (never commit .env), or generate all of it from backend/ with:
#   python scripts/gen_keys.py > ../.env   (prints the custodian private key once, to the terminal)
# Or make each secret yourself with:
#   python -c "import secrets; print(secrets.token_hex(32))"
DATABASE_URL=sqlite:///./hub.db
HMAC_KEY=
JWT_SECRET=
VAULT_PUBLIC_KEY=
SCHEDULER_INTERVAL_SECONDS=15
